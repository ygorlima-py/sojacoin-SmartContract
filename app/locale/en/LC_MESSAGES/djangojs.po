msgstr "Confirm the configuration in MetaMask."

msgid "Confirme a criação do contrato na MetaMask."
msgstr "Confirm contract creation in MetaMask."

msgid "Confirme a nova senha"
msgstr "Confirm the new password"

msgid "Confirme o registro da unidade na carteira."
msgstr "Confirm the unit registration in the wallet."

msgid "Confirme que a empresa aprovou este PDF antes de publicá-lo."
msgstr "Confirm that the company approved this PDF before publishing it."

msgid "Confirmo que a empresa aprovou este PDF para uso com seus participantes."
msgstr "I confirm that the company approved this PDF for use with its participants."

msgid "Consultando a confirmação da rede…"
msgstr "Checking network confirmation…"

msgid "Consultando recibo e endereço do contrato no RPC…"
msgstr "Checking the receipt and contract address through the RPC…"

msgid "Consultando recibo e vínculo no RPC…"
msgstr "Checking the receipt and registry link through the RPC…"

msgid "Consultar confirmação"
msgstr "Check confirmation"

