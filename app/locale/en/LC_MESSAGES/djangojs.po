msgstr "Copy link"

msgid "Código"
msgstr "Code"

msgid "Data e hora da pesagem"
msgstr "Weighing date and time"

msgid "Desconto por grãos avariados (kg)"
msgstr "Damaged grain deduction (kg)"

msgid "Desconto por impurezas (kg)"
msgstr "Impurities deduction (kg)"

msgid "Desconto por umidade (kg)"
msgstr "Moisture deduction (kg)"

msgid "Disponível após a implantação dos nove contratos"
msgstr "Available after all nine contracts are deployed"

msgid "Documento obrigatório que será guardado em armazenamento privado."
msgstr "Required document stored in private storage."

msgid "Documento obrigatório. A hash será calculada sobre os bytes exatos do PDF."
msgstr "Required document. Its hash is calculated from the exact PDF bytes."

msgid "Emissão"
msgstr "Issuance"

msgid "Empresa ou rede não encontrada."
msgstr "The company or network could not be found."

msgid "Endereço"
msgstr "Address"

msgid "Endereço do contrato"
msgstr "Contract address"

msgid "Envia os campos do romaneio e a hash do PDF para confirmLoadReceipt."
msgstr "Sends the weighing ticket fields and PDF hash to confirmLoadReceipt."

msgid "Envie este documento em um arquivo PDF."
msgstr "Upload this document as a PDF file."

msgid "Envie o termo da empresa em um arquivo PDF."
msgstr "Upload the company terms as a PDF file."

msgid "Envie todos os documentos obrigatórios em PDF."
msgstr "Upload all required documents as PDF files."

msgid "Envio cancelado na carteira. Você pode tentar novamente."
msgstr "The wallet canceled the request. You can try again."

msgid "Envio iniciado; hash pendente de conferência"
msgstr "Submission started; hash needs to be checked"

msgid "Envio recusado pela carteira."
msgstr "The wallet declined the submission."

msgid "Escolha recebimento ou emissão."
msgstr "Choose receiving or issuance."

msgid "Escolha uma rede que tenha SojaCoin ativa."
msgstr "Choose a network with an active SojaCoin contract."

msgid "Esta ação já foi enviada. Atualizando a situação da tentativa existente."
msgstr "This action was already submitted. Updating the existing attempt."

msgid "Esta carteira já está cadastrada na SojaCoin."
msgstr "This wallet is already registered in SojaCoin."

msgid "Esta carteira já está cadastrada nesta empresa."
msgstr "This wallet is already registered for this company."

msgid "Esta carteira já tem uma alteração aguardando conclusão. Resolva-a primeiro."
msgstr "A change for this wallet is already in progress. Resolve it first."

msgid "Esta carteira não está autorizada pelo contrato a cancelar o lote."
msgstr "This wallet is not authorized by the contract to cancel the batch."

