msgstr "Call submitted. Waiting for network confirmation."

msgid "Chave de acesso da NF-e"
msgstr "NF-e access key"

msgid "Conceda primeiro o acesso correspondente a esta unidade no SaaS."
msgstr "First grant this person the corresponding unit access in the SaaS."

msgid "Concedida"
msgstr "Granted"

msgid "Concluída"
msgstr "Completed"

msgid "Conectar carteira e implantar"
msgstr "Connect wallet and deploy"

msgid "Conecte a carteira dona atual da SojaCoin para propor o cadastro."
msgstr "Connect the current SojaCoin owner wallet to propose the registration."

msgid "Conecte a carteira dona atual do contrato SojaCoin."
msgstr "Connect the current owner wallet of the SojaCoin contract."

msgid "Conecte a carteira dona da SojaCoin usada nesta tentativa."
msgstr "Connect the owner wallet of the SojaCoin used for this attempt."

msgid "Conecte a carteira dona do UnitRegistry para continuar."
msgstr "Connect the UnitRegistry owner wallet to continue."

msgid "Conecte a carteira dona do UnitRegistry."
msgstr "Connect the UnitRegistry owner wallet."

msgid "Conecte a carteira dona do contrato para continuar."
msgstr "Connect the contract owner wallet to continue."

msgid "Conecte a carteira e confira a rede selecionada."
msgstr "Connect a wallet and check the selected network."

